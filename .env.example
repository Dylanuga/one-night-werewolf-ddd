# Configuración de Puertos
BACKEND_PORT=5000
FRONTEND_PORT=8080

# URL de comunicación con el Backend (IP pública o dominio en producción)
# IMPORTANTE: Reemplazar con http://<IP_PUBLICA_EC2>:5000 en producción
VITE_SOCKET_URL=http://localhost:5000

# Backend Flask settings
# true para desarrollo local, false para producción
FLASK_DEBUG=true

# Clave secreta para cookies de Flask (especificar una clave segura en producción)
# Si se deja vacío, se generará una clave aleatoria en cada inicio del servidor
SECRET_KEY=

# Habilitar panel de pruebas y endpoints de test/debug (true/false)
# true para desarrollo local, false para producción
ENABLE_TEST_ENDPOINTS=true

# Habilitar el botón y la vista del panel de pruebas en el Frontend (true/false)
# true para desarrollo local, false para producción
VITE_ENABLE_TESTING=true
